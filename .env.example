# Telegram API credentials: https://my.telegram.org
API_ID=123456
API_HASH=your_telegram_api_hash
BOT_TOKEN=123456789:your_bot_token

# Telegram numeric user IDs allowed to use the bot, separated by commas
OWNER_IDS=123456789

# DigitalOcean personal access token
DO_TOKEN=your_digitalocean_token

# SSH key IDs from your DigitalOcean account, separated by commas
DO_SSH_KEY_IDS=12345678

# Maximum number of tagged Droplets managed by the bot (default 1)
MAX_MANAGED_DROPLETS=1

# Ubuntu 24.04 LTS
DO_IMAGE=ubuntu-24-04-x64
DO_TAG=managed-by-telegram-bot
